<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Skylane.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
  </ItemGroup>

  <!--
    O wwwroot é gerado pelo build do front-end (src/Skylane.Web) e não está no git.
    Sem a pasta, o ASP.NET Core em Development lança DirectoryNotFoundException ao arrancar,
    por isso criamo-la vazia antes de cada build.
  -->
  <Target Name="EnsureWebRoot" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
  </Target>

  <!--
    Publicar a partir do Visual Studio (ex.: alojamento em IIS, como o MonsterASP.NET):
    compila também o React e inclui o wwwroot no que é publicado, para o site ficar completo.
    O Dockerfile já compila o React à parte, por isso passa -p:BuildWebOnPublish=false.
  -->
  <PropertyGroup>
    <BuildWebOnPublish Condition="'$(BuildWebOnPublish)' == ''">true</BuildWebOnPublish>
    <WebRoot>$(MSBuildProjectDirectory)/../Skylane.Web</WebRoot>
  </PropertyGroup>

  <Target Name="PublishWeb" AfterTargets="ComputeFilesToPublish" Condition="'$(BuildWebOnPublish)' == 'true'">
    <Exec WorkingDirectory="$(WebRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(WebRoot)" Command="npm run build" />

    <!-- Os ficheiros do wwwroot só existem depois do build do React, por isso são acrescentados aqui. -->
    <ItemGroup>
      <WebFiles Include="wwwroot/**" />
      <ResolvedFileToPublish Include="@(WebFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(WebFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
